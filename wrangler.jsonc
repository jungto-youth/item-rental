{
  // SPA 폴백 + API 분기 — assets.directory 는 배포하는 SolidJS 앱(web/dist)이다
  "name": "item-rental",
  "main": "server/src/index.ts",
  "compatibility_date": "2026-09-01",
  // Workers 로그 영속화 (무료) — 500·임베딩 실패를 대시보드에서 확인할 수 있게
  "observability": { "enabled": true },
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // D1 — 앱의 메인 데이터베이스 (PLAN/PLAN_D1_이관.md — Neon에서 이관 완료, Phase 6.5 정리까지
  //   구 시크릿 DATABASE_URL은 2026-09-23 삭제됨. 로컬 개발은 .dev.vars가 아니라 로컬 D1 SQLite를 쓴다)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "item-rental-db",
      "database_id": "438ffd44-c072-4465-a02d-3f53e2fd75b6",
      "migrations_dir": "migrations-d1"
    }
  ],
  "r2_buckets": [
    { "binding": "PHOTOS", "bucket_name": "item-rental-photos" }
  ],
  // 의미 검색 임베딩 — Workers AI @cf/baai/bge-m3 (무료 플랜 포함, API 키 불필요)
  // Workers AI 는 로컬 에뮬레이션이 없어 dev 에서도 원격 세션을 연다. remote: true 는
  // 그 사실을 명시해 dev 경고를 끄는 용도 (배포 동작에는 영향 없음).
  "ai": { "binding": "AI", "remote": true },
  // 반납 지연 다이제스트 — 매일 09:00 KST (00:00 UTC)에 한 번.
  // `scheduled` 핸들러는 server/src/index.ts 에 있다.
  "triggers": { "crons": ["0 0 * * *"] }
}
