// 서버 테스트의 타입 검사 — 이전의 `deno check --sloppy-imports server/tests` 를 대체한다.
// 워커 바인딩 타입이 전역 선언이라(Cloudflare) src 를 import 하는 한 Node 타입과 같이 켠다.
{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types", "@types/node"],
  },
  "include": ["tests"],
}