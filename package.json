{
  "name": "item-rental",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node server/scripts/dev.ts",
    "dev:web": "vite build --watch",
    "dev:web:hmr": "vite",
    "dev:api": "wrangler dev",
    "dev:lan": "node server/scripts/dev-lan.ts",
    "build": "vite build",
    "preview:web": "vite preview",
    "dev:web-lit": "vite --config web-lit/vite.config.ts",
    "build:web-lit": "vite build --config web-lit/vite.config.ts",
    "preview:web-lit": "vite preview --config web-lit/vite.config.ts",
    "check:production": "node server/scripts/check-production-bundle.ts",
    "deploy": "vite build && wrangler deploy",
    "check": "tsc --noEmit -p web && tsc --noEmit -p web-lit && tsc --noEmit -p server && tsc --noEmit -p server/tsconfig.tests.json && tsc --noEmit -p server/tsconfig.scripts.json",
    "test": "vitest run",
    "test:photos": "node web-lit/tests/photo.browser.test.mjs",
    "test:members": "node web-lit/tests/member-access.browser.test.mjs",
    "test:profile": "node web-lit/tests/profile.browser.test.mjs",
    "test:visual": "node web-lit/tests/visual.browser.test.mjs",
    "test:visual:update": "node web-lit/tests/visual.browser.test.mjs --update",
    "test:web": "node web/tests/smoke.browser.test.mjs",
    "db:seed": "node server/scripts/seed.ts",
    "db:import-items": "node server/scripts/import-items.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@fontsource-variable/noto-sans-kr": "^5.3.1",
    "@lit-labs/router": "^0.1.4",
    "@solidjs/vite-plugin": "^3.0.0-next.55",
    "@solidjs/web": "^2.0.0-rc.20",
    "hono": "^4",
    "lit": "^3",
    "solid-js": "^2.0.0-rc.20"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.64.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
