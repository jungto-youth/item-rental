{
  "name": "item-rental",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev:api & npm run dev:web; wait",
    "dev:web": "vite build --watch",
    "dev:web:hmr": "vite",
    "dev:api": "wrangler dev",
    "dev:lan": "node server/scripts/dev-lan.ts",
    "build": "vite build",
    "check:production": "node server/scripts/check-production-bundle.ts",
    "deploy": "vite build && wrangler deploy",
    "check": "tsc --noEmit -p web && tsc --noEmit -p server && tsc --noEmit -p server/tsconfig.tests.json && tsc --noEmit -p server/tsconfig.scripts.json",
    "test": "vitest run",
    "test:photos": "node web/tests/photo.browser.test.mjs",
    "test:members": "node web/tests/member-access.browser.test.mjs",
    "test:profile": "node web/tests/profile.browser.test.mjs",
    "db:seed": "node server/scripts/seed.ts",
    "db:import-items": "node server/scripts/import-items.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.3",
    "@lit-labs/router": "^0.1.4",
    "@neondatabase/serverless": "^1",
    "hono": "^4",
    "lit": "^3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260918.1",
    "@types/node": "^24",
    "playwright": "^1.64.0",
    "typescript": "^5",
    "vite": "^7",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
