{
  "compilerOptions": {
    // deno test/check 가 server 코드의 Cloudflare 바인딩 타입과 node:sqlite 타입을
    // 모두 보게 한다 (tsc -p server 는 server/tsconfig.json 의 types 를 쓴다)
    "types": ["npm:@cloudflare/workers-types", "npm:@types/node"]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1"
  },
  "tasks": {
    "dev": "deno task dev:api & deno task dev:web; wait",
    "dev:web": "vite build --watch",
    "dev:web:hmr": "vite",
    "dev:api": "wrangler dev",
    "build": "vite build",
    "deploy": "vite build && wrangler deploy",
    "check": "tsc --noEmit -p web && tsc --noEmit -p server && deno check --sloppy-imports server/tests server/scripts",
    "test": "deno test -A --sloppy-imports server/tests",
    "db:seed": "deno run -A server/scripts/seed.ts",
    "db:import-items": "deno run -A server/scripts/import-items.ts",
    "db:export-neon": "deno run -A server/scripts/export-neon-to-d1.ts"
  }
}
